{
  "version": "1.0.0",
  "controllers": {
    "ID": {
      "name": "BolasPro ID",
      "type": "slider",
      "role": "hunter",
      "defaultValue": null,
      "generateValue": true,
      "range": [-999999, 999999],
      "description": "Unique identifier for Hunter layer"
    },
    "TARGET_ID": {
      "name": "BolasPro Target ID",
      "type": "slider",
      "role": "prey",
      "defaultValue": null,
      "range": [-999999, 999999],
      "description": "ID of the Hunter to follow"
    },
    "SNAG_POINT": {
      "name": "BolasPro - Snag Point",
      "type": "slider",
      "role": "prey",
      "defaultValue": 5,
      "range": [1, 9],
      "description": "Point on Hunter grid (1-9)"
    },
    "PREY_ANCHOR": {
      "name": "BolasPro - Prey Anchor",
      "type": "slider",
      "role": "prey",
      "defaultValue": 5,
      "range": [1, 9],
      "description": "Point on Prey grid (1-9)"
    },
    "LOCK_ORIENTATION": {
      "name": "BolasPro - Lock Orientation",
      "type": "checkbox",
      "role": "prey",
      "defaultValue": false,
      "description": "Lock rotation to Hunter"
    },
    "OFFSET_X": {
      "name": "BolasPro - Offset X",
      "type": "slider",
      "role": "prey",
      "defaultValue": 0,
      "range": [-10000, 10000],
      "description": "Horizontal offset from snag point"
    },
    "OFFSET_Y": {
      "name": "BolasPro - Offset Y",
      "type": "slider",
      "role": "prey",
      "defaultValue": 0,
      "range": [-10000, 10000],
      "description": "Vertical offset from snag point"
    },
    "OFFSET_Z": {
      "name": "BolasPro - Offset Z",
      "type": "slider",
      "role": "prey",
      "defaultValue": 0,
      "range": [-10000, 10000],
      "condition": "is3D",
      "description": "Depth offset (3D layers only)"
    },
    "POSITION_DELAY": {
      "name": "BolasPro - Position Delay",
      "type": "slider",
      "role": "prey",
      "defaultValue": 0,
      "range": [0, 10],
      "description": "Position follow delay in seconds"
    },
    "ROTATION_DELAY": {
      "name": "BolasPro - Rotation Delay",
      "type": "slider",
      "role": "prey",
      "defaultValue": 0,
      "range": [0, 10],
      "condition": "lockOrientation",
      "description": "Rotation follow delay in seconds"
    }
  },
  "groups": {
    "identity": {
      "description": "Identity controllers (ID and TARGET_ID)",
      "controllers": ["ID", "TARGET_ID"]
    },
    "hunter_identity": {
      "description": "Hunter identity only",
      "controllers": ["ID"]
    },
    "prey_identity": {
      "description": "Prey identity only",
      "controllers": ["TARGET_ID"]
    },
    "anchor_points": {
      "description": "Anchor point controllers",
      "controllers": ["SNAG_POINT", "PREY_ANCHOR"]
    },
    "offsets": {
      "description": "All offset controllers",
      "controllers": ["OFFSET_X", "OFFSET_Y", "OFFSET_Z"]
    },
    "offsets_2d": {
      "description": "2D offset controllers only",
      "controllers": ["OFFSET_X", "OFFSET_Y"]
    },
    "timing": {
      "description": "Timing/delay controllers",
      "controllers": ["POSITION_DELAY", "ROTATION_DELAY"]
    },
    "orientation": {
      "description": "Orientation lock controller",
      "controllers": ["LOCK_ORIENTATION"]
    },
    "prey_controls": {
      "description": "All Prey controls without TARGET_ID",
      "controllers": [
        "SNAG_POINT", "PREY_ANCHOR", "LOCK_ORIENTATION",
        "OFFSET_X", "OFFSET_Y", "OFFSET_Z",
        "POSITION_DELAY", "ROTATION_DELAY"
      ]
    },
    "prey_full": {
      "description": "All Prey controllers including TARGET_ID",
      "controllers": [
        "TARGET_ID", "SNAG_POINT", "PREY_ANCHOR", "LOCK_ORIENTATION",
        "OFFSET_X", "OFFSET_Y", "OFFSET_Z",
        "POSITION_DELAY", "ROTATION_DELAY"
      ]
    },
    "all": {
      "description": "All BolasPro controllers",
      "controllers": [
        "ID", "TARGET_ID", "SNAG_POINT", "PREY_ANCHOR", "LOCK_ORIENTATION",
        "OFFSET_X", "OFFSET_Y", "OFFSET_Z",
        "POSITION_DELAY", "ROTATION_DELAY"
      ]
    }
  }
}
